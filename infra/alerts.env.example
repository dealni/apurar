# Preparacao local; instalar/ativar somente em deploy autorizado.
# Token do DealniBot em arquivo externo ao Git, legivel somente pelo usuario do servico.
APURAR_ALERT_TELEGRAM_TOKEN_FILE=/etc/apurar/alert-token
APURAR_ALERT_TELEGRAM_CHAT_ID=
# Limites iniciais de exemplo: revisar conforme cobertura e espaco existentes.
APURAR_ALERT_MAX_AGE=360
APURAR_ALERT_MAX_PENDING=10000
APURAR_ALERT_MIN_FREE=1073741824
APURAR_ALERT_MAX_BYTES=10737418240

# Preparação local: não instala/ativa serviço nem cria token.
# Token Cloudflare dedicado, somente Account / Account Analytics / Read,
# restrito à conta do Apurar; não reutilizar token administrativo/publicador R2.
APURAR_USAGE_API_TOKEN_FILE=/etc/apurar/analytics-read-token
APURAR_USAGE_ACCOUNT_ID=
APURAR_USAGE_SCRIPT=apurar
APURAR_USAGE_BUCKET=apurar-snapshots
# Reutiliza token/chat do DealniBot em /etc/apurar/alerts.env.
# Uma consulta a cada 300s; duas janelas fechadas de 600s, atraso mínimo 300s.
# Série Worker vazia vale zero se a série R2 da mesma janela tem linhas válidas,
# e vice-versa. Ambas vazias/null/missing: telemetria inconclusiva, sem recuperação.
# Falha Analytics repetida 3 vezes gera aviso; Telegram tenta novamente após 60s.
APURAR_USAGE_REQUESTS=50000
APURAR_USAGE_CPU_MS=1000000
APURAR_USAGE_R2_REQUESTS=500000
APURAR_USAGE_USD_HOUR=1
APURAR_USAGE_GROWTH_RATIO=3
APURAR_USAGE_GROWTH_MIN=10000
APURAR_USAGE_RECOVERY_RATIO=0.8
# Estimativa BRUTA: Worker US$0.30/milhão + US$0.02/milhão CPU ms;
# R2 Standard A US$4.50/milhão, B US$0.36/milhão.
# Não é fatura ou uso mensal: exclui franquias compartilhadas, arredondamento,
# planos, armazenamento, impostos e operações R2 não classificadas.

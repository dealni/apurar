{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apurar",
  "main": "apps/edge/src/worker.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "routes": [],
  "preview_urls": false,
  "vars": { "CHAT_ENABLED": "false" },
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }],
  },
  "migrations": [{ "tag": "v1-chat", "new_sqlite_classes": ["ChatRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "404-page",
  },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "apurar-snapshots" }],
}
